# 数据库配置 (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/thrivex?sslmode=require"

# JWT 配置（必须使用强随机密钥，至少 32 字符）
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="please-replace-with-a-strong-random-secret-at-least-32-chars-long"
JWT_EXPIRES_IN="259200000"

# 服务端口
PORT=9002

# 文件上传配置
FILE_UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# 限流配置
RATE_LIMIT_TOKENS=100
RATE_LIMIT_DURATION=60
BLACKLIST_THRESHOLD=10
BLACKLIST_DURATION=60

# CORS 配置（生产环境必须改为你的域名，不要使用通配符 *）
CORS_ORIGIN="http://localhost:9000,http://localhost:9001"

# 反向代理信任配置
# - 开发环境（无反代）：留空或不设置，默认仅信任 loopback
# - 生产环境（Nginx/Cloudflare）：设为 true 或具体跳数（如 1）
# TRUST_PROXY=true

# 邮件配置
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_USER="your-email@qq.com"
SMTP_PASS="your-auth-code"

# 环境
NODE_ENV="development"
